{
  "id": "com.arisen.physics",
  "name": "Arisen Physics",
  "version": "1.0.0",
  "engine": {
    "minVersion": "0.1.0"
  },
  "layer": "domain",
  "description": "Rigid-body simulation behind a package boundary: the vendored Jolt solver plus the flat C ABI and managed service that gameplay packages consume. Solver types never leave this package.",
  "type": "hybrid",
  "entry": {
    "assembly": "Com.Arisen.Physics.dll",
    "class": "ArisenEngine.Physics.PhysicsPackage"
  },
  "services": {
    "provides": [
      {
        "interface": "ArisenEngine.Physics.IPhysicsService",
        "priority": 100
      }
    ],
    "requires": [
      "ArisenEngine.Resources.Serialization.ISceneComponentExtensionRegistry"
    ]
  },
  "dependencies": {
    "com.arisen.core": "1.0.0",
    "com.arisen.ecs": "1.0.0",
    "com.arisen.resources": "1.0.0"
  },
  "subsystems": [
    {
      "class": "ArisenEngine.Physics.PhysicsRuntimeSubsystem",
      "phase": "Running",
      "priority": 90
    }
  ],
  "nativeRuntimes": {
    "win-x64": [
      {
        "path": "Physics.dll",
        "exports": [
          "Physics_GetSolverVersion",
          "Physics_CreateWorld"
        ]
      }
    ]
  },
  "nativeTests": {
    "win-x64": [
      {
        "library": "Arisen.Physics.Test.dll",
        "registerExport": "RegisterNativeTests"
      }
    ]
  }
}
